{
  "name": "argoscuola.js",
  "version": "1.0.0",
  "description": "API Wrapper per la API di Argo Scuola (Famiglia)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc",
    "cleanbuild": "node -e \"require('fs').rmSync('./dist',{recursive:true,force:true})\" && tsc",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntogamerYT/ArgoScuola.js.git"
  },
  "keywords": [
    "api",
    "wrapper",
    "argo",
    "scuolanext"
  ],
  "author": "AntogamerYT",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/AntogamerYT/ArgoScuola.js/issues"
  },
  "homepage": "https://github.com/AntogamerYT/ArgoScuola.js#readme",
  "dependencies": {
    "base64url": "^3.0.1",
    "fetch-cookie": "^3.2.0",
    "randomstring": "^1.3.1"
  },
  "devDependencies": {
    "typescript": "^6.0.2",
    "@types/node": "^25.6.0",
    "@types/randomstring": "^1.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}